# Required for QPU-16 to talk with Claude. Without it the terminal still works, with canned replies.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MODEL=claude-haiku-5-5
CHAT_RATE_PER_MIN=12
RUN_RATE_PER_MIN=60
# Set to 0 if the app is NOT behind a proxy/load balancer (then X-Forwarded-For is ignored)
TRUST_PROXY=1
LOG_LEVEL=INFO

# ---- X bot (bot/xbot.py) ----
# From developer.x.com: your app's API Key and Secret, plus the bot account's
# Access Token and Secret generated AFTER setting app permissions to "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
POST_MIN_MINUTES=10
POST_MAX_MINUTES=15
MENTION_POLL_SECONDS=90
MAX_REPLIES_PER_POLL=15
MAX_REPLIES_PER_USER_30MIN=3
# 1 = read mentions and log what it would post, but post nothing. Start here, then set 0.
DRY_RUN=1
